---
const tarjetas = [
  {
    etiqueta: "Construir",
    titulo: "Sistemas web a la medida",
    texto: "Plataformas administrativas, ERP y CRM adaptados al 100% al flujo de trabajo de tu empresa. Sin plantillas ni licencias genéricas.",
  },
  {
    etiqueta: "Automatizar",
    titulo: "Automatización de procesos",
    texto: "Eliminamos tareas manuales repetitivas conectando tus bases de datos, facturación y herramientas diarias.",
  },
  {
    etiqueta: "Escalar",
    titulo: "Aplicaciones y APIs",
    texto: "Arquitecturas modernas, rápidas y seguras, listas para crecer junto con tu negocio.",
  },
];
---

<section id="plataforma" class="scroll-mt-20 border-t border-white/10">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <h2 class="text-4xl font-extrabold tracking-tight text-white md:text-5xl">
        Una solución completa para tu operación
      </h2>
      <p class="mt-5 text-lg text-slate-400">
        Desarrollo, automatización e integraciones en un solo equipo: menos herramientas sueltas, más control.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {tarjetas.map((t) => (
        <article class="reveal card-dark flex flex-col p-8">
          <span class="w-fit rounded-full bg-[#4687ff]/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#8fb4ff]">
            {t.etiqueta}
          </span>
          <h3 class="mt-6 text-2xl font-extrabold text-white">{t.titulo}</h3>
          <p class="mt-3 flex-1 leading-relaxed text-slate-400">{t.texto}</p>

          <!-- Mini interfaz decorativa -->
          <div class="mt-8 space-y-2.5 rounded-2xl border border-white/10 bg-[#0b1530] p-4">
            <div class="h-2.5 w-2/3 rounded-full bg-white/15"></div>
            <div class="h-2.5 w-full rounded-full bg-white/10"></div>
            <div class="h-2.5 w-4/5 rounded-full bg-[#4687ff]/60"></div>
          </div>

          <a href="#contacto" class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-[#6b9fff] hover:text-white">
            Descubre cómo <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>