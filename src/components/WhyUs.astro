---
const razones = [
  {
    titulo: "A la medida, de verdad",
    texto: "Diseñamos cada sistema a partir de tu operación, no de una plantilla. Tu flujo de trabajo manda, no el software.",
  },
  {
    titulo: "Tu código, tus datos",
    texto: "Eres dueño del sistema que construimos. Sin dependencia de licencias ni de proveedores cerrados.",
  },
  {
    titulo: "Seguridad desde el diseño",
    texto: "Buenas prácticas de seguridad, respaldo de información y control de accesos desde el primer día.",
  },
];
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
    <div class="reveal flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <h2 class="max-w-2xl text-4xl font-extrabold tracking-tight text-slate-900 md:text-5xl">
        Por qué elegir JESolutions
      </h2>
      <a href="#contacto" class="btn-primary">Cotizar proyecto</a>
    </div>

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      {razones.map((r, i) => (
        <div class="reveal border-t-2 border-slate-900 pt-6">
          <span class="text-sm font-bold text-[#4687ff]">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-3 text-2xl font-extrabold text-slate-900">{r.titulo}</h3>
          <p class="mt-3 leading-relaxed text-slate-600">{r.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>