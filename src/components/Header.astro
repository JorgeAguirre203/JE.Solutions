---
const links = [
  { href: "#plataforma", label: "Soluciones" },
  { href: "#proceso", label: "Cómo trabajamos" },
  { href: "#tecnologias", label: "Tecnologías" },
  { href: "#faq", label: "Preguntas" },
];
---

<div class="bg-[#4687ff] px-4 py-2 text-center text-sm font-semibold text-white">
  Agenda tu consulta gratuita y recibe una propuesta técnica
  <a href="#contacto" class="ml-2 underline underline-offset-2 hover:no-underline">Agendar →</a>
</div>

<header class="sticky top-0 z-50 border-b border-white/10 bg-[#050b1f]/90 backdrop-blur-md">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-6">
    <a href="#" class="flex items-center gap-2.5 text-white">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#4687ff] text-sm font-extrabold">JE</span>
      <span class="text-lg font-extrabold tracking-tight">JESolutions</span>
    </a>

    <nav class="hidden items-center gap-9 text-sm font-semibold text-slate-300 lg:flex">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-white">{l.label}</a>
      ))}
    </nav>

    <a href="#contacto" class="btn-primary hidden !px-6 !py-2.5 lg:inline-flex">Cotizar proyecto</a>

    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-white">
        Menú
      </summary>
      <div class="absolute right-0 mt-3 w-60 rounded-2xl border border-white/10 bg-[#0b1530] p-2 shadow-2xl">
        {links.map((l) => (
          <a href={l.href} class="block rounded-xl px-4 py-2.5 text-sm font-medium text-slate-200 hover:bg-white/5 hover:text-white">
            {l.label}
          </a>
        ))}
        <a href="#contacto" class="btn-primary mt-2 w-full !py-2.5">Cotizar proyecto</a>
      </div>
    </details>
  </div>
</header>