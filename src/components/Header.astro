---
const links = [
  { href: "#servicios", label: "Servicios" },
  { href: "#proceso", label: "Cómo trabajamos" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#" class="flex items-center gap-2.5 text-white">
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-white/10 bg-white/5 text-xs font-semibold tracking-tight">
        JE
      </span>
      <span class="text-[15px] font-medium tracking-tight">JESolutions</span>
    </a>

    <nav class="hidden items-center gap-9 text-sm text-slate-400 md:flex">
      {links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-white">{l.label}</a>
      ))}
    </nav>

    <a
      href="#contacto"
      class="hidden rounded-full border border-white/10 bg-white px-5 py-2 text-sm font-medium text-slate-950 transition hover:bg-slate-200 md:inline-block"
    >
      Cotizar proyecto
    </a>

    <!-- Menú móvil -->
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-white/10 px-3 py-1.5 text-sm text-slate-300">
        Menú
      </summary>
      <div class="absolute right-0 mt-3 w-52 rounded-xl border border-white/10 bg-slate-900 p-2 shadow-xl">
        {links.map((l) => (
          <a href={l.href} class="block rounded-lg px-3 py-2 text-sm text-slate-300 hover:bg-white/5 hover:text-white">
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>